# Copy to .env for local runs (.env is git-ignored). In GitHub Actions these come
# from repository secrets; on Streamlit Cloud, from the app's Secrets settings.
# Never commit real values.

# --- Email report (SMTP) -------------------------------------------------------
SENDER_EMAIL=
# For Gmail, use an App Password (https://myaccount.google.com/apppasswords), not your login password
EMAIL_PASSWORD=
RECIPIENT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Data providers --------------------------------------------------------------
# Optional: analyst ratings, earnings, insider data and news. Free key at finnhub.io
FINNHUB_API_KEY=
# Optional: headline sentiment and strategy notes. Without it sentiment scores 0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Reserved for a Tiingo price fallback (not used yet)
TIINGO_API_KEY=

# --- Dashboard -------------------------------------------------------------------
# Required: the dashboard refuses to render without it
APP_PASSWORD=
# 1 = only the "Analyze Stocks" flow; 0 = also show the owner's portfolio
PUBLIC_MODE=1

# --- Storage / state -----------------------------------------------------------
DB_PATH=quant.db
# PORTFOLIO_PATH=data/master_portfolio.json
# STATE_DIR=.
ACCOUNT_SIZE=10000

# Optional webhook that receives {"ticker", "message"} for each HIGH alert
# PUSH_ALERT_URL=
